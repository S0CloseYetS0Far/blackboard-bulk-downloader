{
  "manifest_version": 3,
  "name": "Blackboard Bulk Downloader",
  "version": "1.0.0",
  "description": "Download all files and folders in a Blackboard course with one click into an organized ZIP archive.",
  "browser_specific_settings": {
    "gecko": {
      "id": "blackboard-downloader@extension.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Blackboard Bulk Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "scripts": [
      "lib/jszip.min.js",
      "lib/bytesbase64.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/webapps/blackboard/*",
        "*://*/ultra/*",
        "*://*/learn/api/public/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}

